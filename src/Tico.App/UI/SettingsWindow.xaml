<Window x:Class="Tico.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tico"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="#141414" CornerRadius="16" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header with Tico avatar -->
            <Border CornerRadius="16,16,0,0" Padding="16,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A1A2E" Offset="0"/>
                        <GradientStop Color="#16132B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <!-- Tico face -->
                        <Grid Width="28" Height="28" Margin="0,0,10,0">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                        <GradientStop Color="#A78BFA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                <Ellipse Width="4" Height="4" Fill="White" Margin="0,0,4,0"/>
                                <Ellipse Width="4" Height="4" Fill="White"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="tico" Foreground="#F0F0F0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="OnClose"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" VerticalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <Ellipse Fill="#FFFFFF" Opacity="0.06"/>
                            <TextBlock Text="&#x2715;" Foreground="#6B6B6B" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </DockPanel>
            </Border>

            <StackPanel Margin="16,12,16,16">

                <!-- Account Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="AccountLabel" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" CornerRadius="10" Padding="10,3">
                                <Border.Background>
                                    <SolidColorBrush Color="#7C3AED" Opacity="0.15"/>
                                </Border.Background>
                                <TextBlock x:Name="TierText" Text="—" Foreground="#A78BFA" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <TextBlock x:Name="EmailText" Text="—" Foreground="#E8E8E8" FontSize="13"
                                   FontWeight="Medium" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>

                        <!-- Usage bar -->
                        <TextBlock x:Name="UsageText" Text="—" Foreground="#8A8A8A" FontSize="11" Margin="0,10,0,0"/>
                        <Border Background="#2A2A2A" CornerRadius="3" Height="5" Margin="0,5,0,0">
                            <Border x:Name="UsageBar" HorizontalAlignment="Left" CornerRadius="3" Width="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7C3AED" Offset="0"/>
                                        <GradientStop Color="#A78BFA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                        <TextBlock x:Name="UsageRemainingText" Text="" Foreground="#6B6B6B" FontSize="10" Margin="0,4,0,0"/>

                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Right" FontSize="11">
                            <Hyperlink x:Name="LogoutLink" Click="OnLogout" Foreground="#7C3AED" TextDecorations="None">
                                <Run x:Name="LogoutText"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Tip -->
                <Border Background="#7C3AED" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" Opacity="0.9">
                    <TextBlock x:Name="HotkeyTipText" Foreground="White" FontSize="11.5"
                               FontWeight="Medium" HorizontalAlignment="Center"/>
                </Border>

                <!-- Hotkey Card -->
                <Border Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <TextBlock x:Name="HotkeyLabel" Style="{StaticResource LabelText}" DockPanel.Dock="Left"/>
                        <Button x:Name="HotkeyButton" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                MinWidth="80" Padding="14,6" Background="#0A0A0A" Foreground="#E8E8E8"
                                BorderBrush="#7C3AED" BorderThickness="1" FontSize="11" FontWeight="SemiBold"
                                Cursor="Hand" Click="OnHotkeyClick">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- Model Card -->
                <Border Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <TextBlock x:Name="ModelLabel" Style="{StaticResource LabelText}" DockPanel.Dock="Left"/>
                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Background="#0A0A0A" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnSonnet" Content="Sonnet" Click="OnSelectSonnet"
                                        Padding="12,6" Background="Transparent" Foreground="#6B6B6B"
                                        BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                                <Button x:Name="BtnOpus" Content="Opus" Click="OnSelectOpus"
                                        Padding="12,6" Background="Transparent" Foreground="#6B6B6B"
                                        BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Voice Card -->
                <Border Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <TextBlock x:Name="VoiceLabel" Style="{StaticResource LabelText}" DockPanel.Dock="Left"/>
                        <ComboBox x:Name="VoiceCombo" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                  Width="170" Background="#0A0A0A" Foreground="#B0B0B0"
                                  BorderBrush="#2A2A2A" FontSize="11">
                            <ComboBoxItem Content="Nova (feminina)" Tag="nova" IsSelected="True"/>
                            <ComboBoxItem Content="Shimmer (feminina)" Tag="shimmer"/>
                            <ComboBoxItem Content="Alloy (neutra)" Tag="alloy"/>
                            <ComboBoxItem Content="Echo (masculina)" Tag="echo"/>
                            <ComboBoxItem Content="Onyx (masculina)" Tag="onyx"/>
                            <ComboBoxItem Content="Fable (neutra)" Tag="fable"/>
                        </ComboBox>
                    </DockPanel>
                </Border>

                <!-- Toggles Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="ShowTicoLabel" Style="{StaticResource LabelText}" DockPanel.Dock="Left"/>
                            <CheckBox x:Name="ShowBuddyToggle" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                      IsChecked="True" Checked="OnBuddyToggleChanged" Unchecked="OnBuddyToggleChanged"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock x:Name="ChatHistoryLabel" Style="{StaticResource LabelText}" DockPanel.Dock="Left"/>
                            <CheckBox x:Name="ChatHistoryToggle" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                      IsChecked="True" Checked="OnChatHistoryToggleChanged" Unchecked="OnChatHistoryToggleChanged"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <TextBlock Text="tico v1.0.0  ·  ticoai.app" Foreground="#4A4A4A" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

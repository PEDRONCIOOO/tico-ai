<Window x:Class="Tico.App.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tico — Entrar"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Border Background="#171918" CornerRadius="12" BorderBrush="#1A1A1A" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header with close button -->
            <DockPanel Margin="20,16,16,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse Width="8" Height="8" Fill="#7C3AED" Margin="0,0,8,0">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" Color="#7C3AED"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="tico" Foreground="#ECEEED" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="OnClose"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                    <Grid Width="20" Height="20">
                        <Ellipse Fill="#FFFFFF" Opacity="0.08"/>
                        <TextBlock Text="&#x2715;" Foreground="#6B736F" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </DockPanel>

            <!-- Title -->
            <TextBlock Text="entrar" Foreground="#ECEEED" FontSize="22" FontWeight="Bold"
                       Margin="20,18,20,2"/>
            <TextBlock Text="acesse sua conta do tico" Foreground="#6B736F" FontSize="12"
                       Margin="20,0,20,16"/>

            <!-- Email -->
            <TextBlock Text="EMAIL" Foreground="#6B736F" FontSize="10" FontWeight="Bold"
                       Margin="20,0,20,4"/>
            <Border Background="#0F0F0F" CornerRadius="6" BorderBrush="#2A2A2A" BorderThickness="0.5"
                    Margin="20,0,20,12">
                <TextBox x:Name="EmailBox" Background="Transparent" Foreground="#ECEEED"
                         BorderThickness="0" Padding="10,8" FontSize="13"
                         CaretBrush="#7C3AED"/>
            </Border>

            <!-- Password -->
            <TextBlock Text="SENHA" Foreground="#6B736F" FontSize="10" FontWeight="Bold"
                       Margin="20,0,20,4"/>
            <Border Background="#0F0F0F" CornerRadius="6" BorderBrush="#2A2A2A" BorderThickness="0.5"
                    Margin="20,0,20,12">
                <PasswordBox x:Name="PasswordBox" Background="Transparent" Foreground="#ECEEED"
                             BorderThickness="0" Padding="10,8" FontSize="13"
                             CaretBrush="#7C3AED"
                             KeyDown="OnPasswordKeyDown"/>
            </Border>

            <!-- Error message -->
            <Border x:Name="ErrorBox" Background="#3A1418" CornerRadius="6" BorderBrush="#5A1F26"
                    BorderThickness="0.5" Margin="20,0,20,12" Visibility="Collapsed" Padding="10,7">
                <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Submit button -->
            <Button x:Name="LoginButton" Click="OnLogin" Cursor="Hand"
                    Background="#7C3AED" Foreground="White" BorderThickness="0"
                    FontSize="13" FontWeight="SemiBold"
                    Margin="20,4,20,0" Height="38">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Spinner (hidden by default) — 270° arc that rotates -->
                    <Canvas x:Name="Spinner" Width="16" Height="16" Margin="0,0,8,0"
                            Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation"/>
                        </Canvas.RenderTransform>
                        <!-- Track -->
                        <Ellipse Width="16" Height="16" Stroke="White" StrokeThickness="2" Opacity="0.2"/>
                        <!-- Arc (270°) -->
                        <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M8,0 A8,8 0 1 1 0,8"/>
                    </Canvas>
                    <TextBlock x:Name="LoginButtonText" Text="entrar" Foreground="White"/>
                </StackPanel>
            </Button>

            <!-- Create account link -->
            <TextBlock Margin="20,14,20,18" HorizontalAlignment="Center" FontSize="12">
                <Run Text="ainda não tem conta? " Foreground="#6B736F"/><Hyperlink x:Name="RegisterLink"
                    Click="OnOpenRegister" Foreground="#7C3AED" TextDecorations="None">
                    criar conta
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>

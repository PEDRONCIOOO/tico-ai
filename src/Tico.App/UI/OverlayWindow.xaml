<Window x:Class="Tico.App.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Canvas x:Name="OverlayCanvas">
        <!-- Underline glow at pointed element -->
        <Rectangle x:Name="GlowUnderline"
                   Width="160" Height="3"
                   RadiusX="1.5" RadiusY="1.5"
                   Fill="#7C3AED"
                   Visibility="Collapsed">
            <Rectangle.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.8" Color="#7C3AED"/>
            </Rectangle.Effect>
        </Rectangle>
    </Canvas>
</Window>

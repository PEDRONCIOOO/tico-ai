{
  "manifest_version": 3,
  "name": "TicoAI",
  "version": "1.0.0",
  "description": "Your AI browsing companion. Talk to Tico while browsing — it sees your tab, answers by voice, and points at what matters.",
  "icons": {
    "16": "icons/tico-16.png",
    "32": "icons/tico-32.png",
    "48": "icons/tico-48.png",
    "128": "icons/tico-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/buddy.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/tico-16.png",
      "32": "icons/tico-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Start or stop voice recording"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "offscreen",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
